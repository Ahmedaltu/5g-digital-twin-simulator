# Dockerfile for Backend (simulation engine)
FROM python:3.10-slim-bookworm
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
RUN useradd -m appuser && mkdir -p /app/data /app/logs && chown -R appuser:appuser /app
USER appuser
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD test -f /app/data/simulation_results.csv || exit 1
CMD ["python", "5g-digital-twin-simulator/main.py"]
